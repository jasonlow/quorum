        { "agent": "Risk Manager", "stance": "concise restatement of their view" },
        { "agent": "Treasury / Ops", "stance": "..." }
      ],
      "chairSuggestion": "your proposed resolution for the chair"
    }
  ],
  "agentBreakdown": [
    {
      "agent": "Risk Manager",
      "summary": "≤25 word summary of their position",
      "verdict": "APPROVE | APPROVE_WITH_CONDITIONS | REJECT | NO_OPINION"
